<!DOCTYPE html>
<html lang="{{ p.lang_tag }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="theme-color" content="#2668FF">
<!-- Favicon и иконки KOZYR -->
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="KOZYR">
<meta property="og:locale" content="{{ p.og_locale }}">
<meta property="og:title" content="{{ content.og_title }}">
<meta property="og:description" content="{{ content.og_description }}">
<meta property="og:image" content="https://kozyr.club/og-{{ p.kind }}-{{ p.id }}.jpg">
<meta property="og:image:width" content="2400">
<meta property="og:image:height" content="1260">
<meta property="og:url" content="{{ p.canonical }}">
<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ content.og_title }}">
<meta name="twitter:description" content="{{ content.og_description }}">
<meta name="twitter:image" content="https://kozyr.club/og-{{ p.kind }}-{{ p.id }}.jpg">

<title>{{ content.meta_title }}</title>
<meta name="description" content="{{ content.meta_description }}">

<link rel="canonical" href="{{ p.canonical }}">
<link rel="alternate" hreflang="ru-UA" href="https://kozyr.club/{{ p.country }}/{{ p.kind }}/{{ p.id }}/">
<link rel="alternate" hreflang="uk-UA" href="https://kozyr.club/{{ p.country }}/uk/{{ p.kind }}/{{ p.id }}/">
<link rel="alternate" hreflang="x-default" href="https://kozyr.club/">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@6.11.0/css/flag-icons.min.css">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ p.name }}",
  "description": {{ content.schema_description | tojson }},
  "brand": {
    "@type": "Brand",
    "name": "{{ p.name }}"
  },
  "category": "Online Poker Room",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.4",
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": "5",
    "reviewCount": "5"
  },
  "review": [
    {
      "@type": "Review",
      "author": {"@type": "Person", "name": "Артём В."},
      "datePublished": "2026-08-18",
      "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1"},
      "reviewBody": "Заходишь в бота — и сразу за столом, ничего скачивать не надо. Депозит USDT через TON прошёл за секунды, вывод тоже мгновенный. Для крипто-игры очень удобно."
    },
    {
      "@type": "Review",
      "author": {"@type": "Person", "name": "Никита Р."},
      "datePublished": "2026-08-02",
      "reviewRating": {"@type": "Rating", "ratingValue": "4", "bestRating": "5", "worstRating": "1"},
      "reviewBody": "Поля мягкие, много любителей вечером. Минус — только крипта, карты не завезли. Но выводы реально быстрые, за это плюс."
    },
    {
      "@type": "Review",
      "author": {"@type": "Person", "name": "Оля Т."},
      "datePublished": "2026-07-21",
      "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1"},
      "reviewBody": "Вход через Telegram занял секунды, никакой верификации. Играю с телефона в дороге прямо в мессенджере — это удобно."
    },
    {
      "@type": "Review",
      "author": {"@type": "Person", "name": "Дмитрий К."},
      "datePublished": "2026-07-09",
      "reviewRating": {"@type": "Rating", "ratingValue": "4", "bestRating": "5", "worstRating": "1"},
      "reviewBody": "Кэш NL25–NL50 живой, оверлеи в турнирах приятные. Сетка МТТ пока небольшая, но по вечерам народ есть."
    },
    {
      "@type": "Review",
      "author": {"@type": "Person", "name": "Влад С."},
      "datePublished": "2026-06-25",
      "reviewRating": {"@type": "Rating", "ratingValue": "4", "bestRating": "5", "worstRating": "1"},
      "reviewBody": "{{ t.fact_rakeback }} через партнёра пришёл 2 числа как обещали. HUD не работает — играю на чистом ридинге, для микро это даже плюс."
    }
  ],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USDT",
    "availability": "https://schema.org/InStock",
    "url": "https://kozyr.club/{{ p.country }}/{{ p.kind }}/{{ p.id }}/"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
        {% for item in p.faq %}{"@type": "Question", "name": {{ item.q | tojson }}, "acceptedAnswer": {"@type": "Answer", "text": {{ item.a | tojson }}}}{% if not loop.last %},{% endif %}
        {% endfor %}]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "{{ t.bc_home }}", "item": "https://kozyr.club/ua/"},
    {"@type": "ListItem", "position": 2, "name": "{{ t.nav_rooms }}", "item": "https://kozyr.club/ua/rooms/"},
    {"@type": "ListItem", "position": 3, "name": "{{ p.name }}", "item": "https://kozyr.club/{{ p.country }}/{{ p.kind }}/{{ p.id }}/"}
  ]
}
</script>

<style>
:root {
  --bg: #FAFAFC;
  --surface: #FFFFFF;
  --surface-alt: #F5F7FB;
  --surface-warm: #F5F1E8;
  --surface-dark: #000714;
  --ink: #0A1128;
  --ink-2: #5C6580;
  --ink-3: #8B90A5;
  --accent: #2668FF;
  --accent-deep: #1E52D9;
  --accent-tint: #EBF1FF;
  --hot: #E63946;
  --hot-tint: #FDECEE;
  --success: #05A661;
  --success-tint: #E5F5EC;
  --border: #E5E7EE;
  --line: #E5E7EE;
  --border-2: #D0D5E0;
  --border-hair: rgba(10,17,40,0.08);
  --r: 8px;
  --r-lg: 16px;
  --r-xl: 24px;
  --r-card: 14px;
  --f-display: 'Space Grotesk', system-ui, sans-serif;
  --f-body: 'Inter', system-ui, sans-serif;
  --f-mono: 'JetBrains Mono', ui-monospace, monospace;
  --f-serif: 'Instrument Serif', Georgia, 'Times New Roman', serif;
  --w: 1280px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  scroll-padding-top: 140px;
}

body {
  font-family: var(--f-body);
  background: var(--bg);
  color: var(--ink);
  font-size: 16px;
  line-height: 1.65;
}

a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; border: none; background: none; }
::selection { background: var(--accent); color: #fff; }
img, svg { display: block; max-width: 100%; }

.wrap { max-width: var(--w); margin: 0 auto; padding: 0 32px; }

.compliance {
  background: var(--surface-alt);
  border-bottom: 1px solid var(--border);
}
.compliance-inner {
  max-width: var(--w);
  margin: 0 auto;
  padding: 11px 32px;
  font-family: var(--f-body);
  font-size: 12px;
  color: var(--ink-3);
  line-height: 1.5;
  text-align: center;
}
.compliance-inner a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }

.nav {
  position: sticky; top: 0; z-index: 100;
  background: rgba(250,250,252,0.9);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid var(--border);
}
.nav-inner {
  display: flex; align-items: center; justify-content: space-between;
  height: 72px; padding: 0 32px;
  max-width: var(--w); margin: 0 auto;
}
.logo { display: flex; align-items: center; gap: 10px; font-family: var(--f-display); font-weight: 700; font-size: 20px; letter-spacing: -0.02em; }
.logo-mark { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; }
.logo-mark svg { width: 100%; height: 100%; display: block; }
.nav-links { display: flex; gap: 32px; font-size: 14px; color: var(--ink-2); font-weight: 500; }
.nav-links a:hover { color: var(--ink); }
.nav-actions { display: flex; align-items: center; gap: 24px; }

.btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: var(--r); font-weight: 500; font-size: 14px; transition: all 0.2s; }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-deep); transform: translateY(-1px); }
.btn-dark { background: var(--ink); color: #fff; }
.btn-dark:hover { background: #001344; transform: translateY(-1px); }
.btn-ghost { background: transparent; color: var(--ink); border: 1px solid var(--border-2); }
.btn-ghost:hover { border-color: var(--ink); }
.btn-lg { padding: 16px 28px; font-size: 15px; }
.btn-xl { padding: 20px 34px; font-size: 16px; border-radius: var(--r-lg); }

.breadcrumbs {
  padding: 32px 0 12px;
  font-family: var(--f-mono);
  font-size: 11px;
  color: var(--ink-3);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.breadcrumbs a { color: var(--ink-3); transition: color 0.15s; }
.breadcrumbs a:hover { color: var(--ink); }
.breadcrumbs .sep { margin: 0 8px; color: var(--border-2); }
.breadcrumbs .current { color: var(--ink); }

.room-hero {
  padding: 32px 0 72px;
  border-bottom: 1px solid var(--border);
}

.room-hero-inner {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 72px;
  align-items: start;
}

.room-tag {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--f-mono);
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-bottom: 20px;
  padding: 6px 12px;
  background: var(--accent-tint);
  border-radius: 100px;
}

.room-hero h1 {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: clamp(48px, 6vw, 88px);
  line-height: 0.98;
  letter-spacing: -0.04em;
  margin-bottom: 24px;
  color: var(--ink);
}

.room-hero h1 em {
  font-family: var(--f-serif);
  font-style: italic;
  font-weight: 400;
  color: var(--accent);
}

.room-hero-lead {
  font-size: 19px;
  line-height: 1.6;
  color: var(--ink-2);
  max-width: 560px;
  margin-bottom: 28px;
}

.room-verdict {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 20px 24px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  margin-bottom: 28px;
  max-width: 560px;
}

.room-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 20px;
  border-right: 1px solid var(--border);
  min-width: 88px;
}

.room-score-num {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 42px;
  line-height: 1;
  color: var(--ink);
  letter-spacing: -0.04em;
}

.room-score-of {
  font-family: var(--f-mono);
  font-size: 10px;
  color: var(--ink-3);
  letter-spacing: 0.1em;
  margin-top: 4px;
}

.room-verdict-text { flex: 1; }

.room-verdict-label {
  font-family: var(--f-mono);
  font-size: 10px;
  color: var(--ink-3);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.room-verdict-text p {
  font-family: var(--f-serif);
  font-style: italic;
  font-size: 18px;
  color: var(--ink);
  line-height: 1.35;
}

.room-hero-ctas {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
}

.room-facts {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 32px;
  box-shadow: 0 20px 40px rgba(10,17,40,0.06);
  position: sticky;
  top: 92px;
}

.room-facts-badge {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 24px;
}

.room-facts-logo--img { background: none !important; overflow: hidden; border: 1px solid var(--border); }
.room-facts-logo--img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.room-facts-logo {
  width: 48px;
  height: 48px;
  background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 20px;
  color: #fff;
  letter-spacing: -0.02em;
}

.room-facts-name {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 18px;
  letter-spacing: -0.015em;
  color: var(--ink);
}

.room-facts-sub {
  font-family: var(--f-mono);
  font-size: 10px;
  color: var(--ink-3);
  letter-spacing: 0.1em;
  margin-top: 4px;
}

.room-facts dl {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 24px;
}

.room-facts .fact {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  padding-bottom: 14px;
  border-bottom: 1px dashed var(--border);
}
.room-facts .fact:last-child { border-bottom: 0; padding-bottom: 0; }

.room-facts dt {
  font-family: var(--f-body);
  font-size: 13px;
  color: var(--ink-2);
  flex-shrink: 0;
}

.room-facts dd {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 14px;
  color: var(--ink);
  text-align: right;
  letter-spacing: -0.01em;
}

.room-facts dd.pending {
  font-family: var(--f-mono);
  font-weight: 500;
  font-size: 11px;
  color: var(--ink-3);
  letter-spacing: 0.06em;
  padding: 3px 8px;
  border: 1px dashed var(--border-2);
  border-radius: 100px;
}

.room-facts dd.highlight {
  color: var(--accent);
  font-size: 18px;
}

.room-facts-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: var(--ink);
  color: #fff;
  padding: 16px 24px;
  border-radius: 100px;
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.01em;
  transition: all 0.2s;
  width: 100%;
}
.room-facts-cta:hover { background: #001344; transform: translateY(-1px); }

.room-facts-note {
  font-family: var(--f-mono);
  font-size: 10px;
  color: var(--ink-3);
  letter-spacing: 0.06em;
  text-align: center;
  margin-top: 14px;
  line-height: 1.5;
}

.article {
  padding: 72px 0 120px;
  display: grid;
  grid-template-columns: 220px 1fr 260px;
  gap: 56px;
  max-width: var(--w);
  margin: 0 auto;
  padding-left: 32px;
  padding-right: 32px;
}

.article-toc {
  position: sticky;
  top: 92px;
  align-self: start;
  max-height: calc(100vh - 120px);
  overflow-y: auto;
}

.article-toc-label {
  font-family: var(--f-mono);
  font-size: 10px;
  color: var(--ink-3);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-bottom: 16px;
  padding-left: 12px;
}

.article-toc ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.article-toc a {
  display: block;
  padding: 8px 12px;
  font-family: var(--f-body);
  font-size: 13px;
  font-weight: 500;
  color: var(--ink-2);
  border-radius: var(--r);
  transition: all 0.15s;
  border-left: 2px solid transparent;
  margin-left: -2px;
  line-height: 1.4;
}
.article-toc a:hover { color: var(--ink); background: var(--surface-alt); }
.article-toc a.active {
  color: var(--accent);
  border-left-color: var(--accent);
  background: var(--accent-tint);
}

.article-body { min-width: 0; max-width: 700px; }

.article-body h2 {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: clamp(28px, 3vw, 40px);
  line-height: 1.1;
  letter-spacing: -0.03em;
  margin: 64px 0 20px;
  color: var(--ink);
  scroll-margin-top: 100px;
}
.article-body h2:first-child { margin-top: 0; }

.article-body h2 em {
  font-family: var(--f-serif);
  font-style: italic;
  font-weight: 400;
  color: var(--accent);
}

.article-body h3 {
  font-family: var(--f-display);
  font-weight: 600;
  font-size: 20px;
  line-height: 1.3;
  color: var(--ink);
  margin: 36px 0 14px;
}

.article-body p {
  font-family: var(--f-body);
  font-size: 16px;
  line-height: 1.75;
  color: var(--ink-2);
  margin-bottom: 18px;
}

.article-body p strong { color: var(--ink); font-weight: 600; }

.article-body p em {
  font-family: var(--f-serif);
  font-style: italic;
  color: var(--ink);
  font-size: 17px;
}

.article-body a {
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.15s;
}
.article-body a:hover { color: var(--accent-deep); }

.article-body ul,
.article-body ol { margin: 12px 0 24px; padding-left: 24px; }

.article-body li {
  font-family: var(--f-body);
  font-size: 16px;
  line-height: 1.75;
  color: var(--ink-2);
  margin-bottom: 10px;
}

.article-body li::marker { color: var(--accent); }
.article-body li strong { color: var(--ink); font-weight: 600; }

.pending-callout {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 10px;
  font-family: var(--f-mono);
  font-size: 11px;
  color: var(--ink-3);
  background: var(--surface-alt);
  border: 1px dashed var(--border-2);
  border-radius: 100px;
  letter-spacing: 0.04em;
  margin: 0 2px;
}

.pending-callout::before {
  content: '';
  width: 6px;
  height: 6px;
  background: var(--ink-3);
  border-radius: 50%;
}

.info-card {
  padding: 24px 28px;
  background: var(--surface-alt);
  border-left: 3px solid var(--accent);
  border-radius: 0 var(--r-lg) var(--r-lg) 0;
  margin: 24px 0 28px;
}

.info-card p { margin-bottom: 0; font-size: 15px; }
.info-card p strong { color: var(--ink); }

.warning-card {
  padding: 24px 28px;
  background: #FFF8E7;
  border-left: 3px solid #E8B547;
  border-radius: 0 var(--r-lg) var(--r-lg) 0;
  margin: 24px 0 28px;
}
.warning-card p { margin-bottom: 0; font-size: 15px; color: #7A5A00; }
.warning-card p strong { color: #513C00; }

.success-card {
  padding: 24px 28px;
  background: var(--success-tint);
  border-left: 3px solid var(--success);
  border-radius: 0 var(--r-lg) var(--r-lg) 0;
  margin: 24px 0 28px;
}
.success-card p { margin-bottom: 0; font-size: 15px; color: #044D2E; }
.success-card p strong { color: #033924; }

.proscons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin: 28px 0 32px;
}

.proscons-block {
  padding: 24px 28px;
  border-radius: var(--r-lg);
  border: 1px solid var(--border);
}

.proscons-pros { background: var(--success-tint); border-color: rgba(5,166,97,0.2); }
.proscons-cons { background: var(--hot-tint); border-color: rgba(230,57,70,0.2); }

.proscons-title {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 16px;
  letter-spacing: -0.01em;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.proscons-pros .proscons-title { color: #044D2E; }
.proscons-cons .proscons-title { color: #7A1D26; }

.proscons ul {
  list-style: none;
  padding-left: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.proscons li {
  font-family: var(--f-body);
  font-size: 14px;
  line-height: 1.55;
  padding-left: 22px;
  position: relative;
  margin-bottom: 0;
}

.proscons-pros li { color: #033924; }
.proscons-cons li { color: #6B1721; }

.proscons li::before { position: absolute; left: 0; font-weight: 700; font-size: 13px; }

.data-table {
  width: 100%;
  border-collapse: collapse;
  margin: 20px 0 28px;
  font-family: var(--f-body);
  font-size: 14px;
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  overflow: hidden;
}

.data-table thead { background: var(--surface-alt); }

.data-table th,
.data-table td {
  padding: 14px 20px;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

.data-table tr:last-child td { border-bottom: 0; }

.data-table th {
  font-family: var(--f-mono);
  font-size: 11px;
  color: var(--ink-3);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 500;
}

.data-table td { color: var(--ink-2); }
.data-table td:first-child { font-weight: 500; color: var(--ink); }

.spec-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 20px 0 28px; }
.spec-box { padding: 20px; background: var(--surface-alt); border: 1px solid var(--border); border-radius: var(--r-lg); text-align: center; }
.spec-box-num { font-family: var(--f-display); font-weight: 700; font-size: 22px; color: var(--ink); letter-spacing: -0.02em; }
.spec-box-cap { font-family: var(--f-mono); font-size: 10px; color: var(--ink-3); letter-spacing: 0.08em; text-transform: uppercase; margin-top: 6px; }

.article-faq { margin: 32px 0 0; border-top: 1px solid var(--border); }
.article-faq-item { border-bottom: 1px solid var(--border); }

.article-faq-q {
  width: 100%;
  padding: 24px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  text-align: left;
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 18px;
  letter-spacing: -0.015em;
  color: var(--ink);
  transition: color 0.15s;
}
.article-faq-q:hover { color: var(--accent); }

.article-faq-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--accent);
  transition: transform 0.25s;
}
.article-faq-item.open .article-faq-icon { transform: rotate(45deg); }

.article-faq-a { max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out; }
.article-faq-item.open .article-faq-a { max-height: 500px; }

.article-faq-a p { padding: 0 0 24px; font-size: 15px; line-height: 1.7; color: var(--ink-2); }

.article-side { position: sticky; top: 92px; align-self: start; }

.side-cta { background: var(--surface-dark); color: #fff; border-radius: 20px; padding: 28px; margin-bottom: 20px; }
.side-cta-label { font-family: var(--f-mono); font-size: 10px; color: rgba(255,255,255,0.5); letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 12px; }
.side-cta-value { font-family: var(--f-display); font-weight: 700; font-size: 48px; line-height: 0.9; letter-spacing: -0.04em; margin-bottom: 8px; }
.side-cta-value em { font-family: var(--f-serif); font-style: italic; font-weight: 400; color: var(--accent); }
.side-cta-desc { font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.5; margin-bottom: 20px; }

.side-cta-btn {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  background: var(--accent); color: #fff; padding: 14px 20px; border-radius: 100px;
  font-family: var(--f-display); font-weight: 700; font-size: 13px; letter-spacing: 0.01em;
  transition: all 0.2s; width: 100%;
}
.side-cta-btn:hover { background: var(--accent-deep); }
.side-cta-btn svg { width: 14px; height: 14px; }

.side-related { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 24px; }
.side-related-title { font-family: var(--f-mono); font-size: 10px; color: var(--ink-3); letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 16px; }
.side-related ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.side-related a { font-family: var(--f-body); font-size: 13px; color: var(--ink-2); line-height: 1.4; transition: color 0.15s; display: flex; align-items: flex-start; gap: 8px; }
.side-related a:hover { color: var(--accent); }
.side-related a::before { content: '→'; color: var(--ink-3); flex-shrink: 0; }

.footer { background: var(--surface-dark); color: rgba(255,255,255,0.7); padding: 80px 0 40px; border-top: 1px solid rgba(255,255,255,0.06); }
.footer-inner { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr; gap: 56px; padding-bottom: 56px; border-bottom: 1px solid rgba(255,255,255,0.08); }
.footer-brand .logo { color: #fff; margin-bottom: 24px; }
.footer-brand p { font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin-bottom: 28px; max-width: 280px; }
.footer-col h3 { font-family: var(--f-display); font-weight: 600; font-size: 12px; color: #fff; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 20px; }
.footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 12px; }
.footer-col a { font-size: 14px; color: rgba(255,255,255,0.55); transition: color 0.15s; }
.footer-col a:hover { color: #fff; }
.footer-bottom { padding-top: 32px; display: flex; justify-content: space-between; align-items: center; font-family: var(--f-mono); font-size: 11px; color: rgba(255,255,255,0.35); letter-spacing: 0.04em; }

@media (max-width: 1200px) {
  .article { grid-template-columns: 200px 1fr; gap: 48px; }
  .article-side { display: none; }
}

@media (max-width: 1024px) {
  .room-hero-inner { grid-template-columns: 1fr; gap: 40px; }
  .room-facts { position: static; }
  .article { grid-template-columns: 1fr; gap: 32px; }
  .article-toc { position: static; max-height: none; }
  .article-toc ul { flex-direction: row; overflow-x: auto; gap: 4px; }
  .article-toc a { white-space: nowrap; font-size: 12px; }
  .footer-inner { grid-template-columns: 1fr 1fr; gap: 32px; }
  .proscons { grid-template-columns: 1fr; }
  .spec-grid { grid-template-columns: 1fr; }
}

@media (max-width: 720px) {
  .wrap { padding: 0 20px; }
  .compliance-inner { padding: 10px 20px; font-size: 11px; }
  .nav-inner { padding: 0 20px; height: 60px; }
  .nav-links { display: none; }
  .article { padding-left: 20px; padding-right: 20px; padding-top: 40px; padding-bottom: 80px; }
  .room-hero { padding: 24px 0 48px; }
  .room-verdict { flex-direction: column; align-items: flex-start; gap: 16px; }
  .room-score { padding-right: 0; padding-bottom: 16px; border-right: 0; border-bottom: 1px solid var(--border); width: 100%; align-items: flex-start; }
  .room-facts { padding: 24px; }
  .footer-inner { grid-template-columns: 1fr; gap: 32px; }
  .footer-bottom { flex-direction: column; gap: 12px; }
}

:root {
  --bg:            #F6F7FB;
  --surface:       #FFFFFF;
  --surface-alt:   #EEF1F8;
  --surface-warm:  #F3EFE6;
  --surface-dark:  #070C18;
  --ink:           #0A1128;
  --ink-2:         #495168;
  --ink-3:         #626B80;
  --accent:        #2E6BFF;
  --accent-deep:   #1B4FD9;
  --accent-tint:   #E7EEFF;
  --gold:          #9C6A18;
  --gold-deep:     #7E5512;
  --gold-tint:     #F5EEDD;
  --hot:           #F0384A;
  --hot-tint:      #FDE9EB;
  --success:       #06B36A;
  --success-tint:  #E7F7EF;
  --border:        #E3E7F1;
  --border-2:      #C9D0E0;
  --r:    10px;
  --r-lg: 18px;
  --r-xl: 28px;
  --r-card: 16px;
  --shadow-sm: 0 1px 2px rgba(10,17,40,.04), 0 4px 14px rgba(10,17,40,.05);
  --shadow-md: 0 12px 34px rgba(10,17,40,.10), 0 3px 10px rgba(10,17,40,.06);
  --shadow-lg: 0 30px 70px rgba(10,17,40,.16), 0 6px 18px rgba(10,17,40,.08);
  --ease: cubic-bezier(.22,1,.36,1);
}

body { font-size: 16.5px; letter-spacing: -0.006em; }
body::before {
  content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background:
    radial-gradient(1100px 700px at 12% -8%, rgba(46,107,255,.06), transparent 60%),
    radial-gradient(900px 600px at 100% 6%, rgba(224,169,59,.04), transparent 55%);
}

.nav { background: rgba(246,247,251,.82); border-bottom: 1px solid transparent; transition: border-color .3s, box-shadow .3s, background .3s; }
.nav.is-stuck { border-bottom-color: var(--border); box-shadow: 0 8px 24px rgba(10,17,40,.05); }
.nav-inner { height: 76px; }
.logo { font-size: 21px; }
.logo-mark { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; transition: transform .3s var(--ease); }
.logo-mark svg { width: 100%; height: 100%; display: block; }
.logo:hover .logo-mark { transform: rotate(-8deg) scale(1.05); }
.nav-links { gap: 34px; font-size: 14.5px; }
.nav-links a { position: relative; padding: 4px 0; }
.nav-links a::after { content: ""; position: absolute; left: 0; right: 100%; bottom: -2px; height: 2px; background: var(--accent); border-radius: 2px; transition: right .28s var(--ease); }
.nav-links a:hover::after { right: 0; }

.btn { border-radius: var(--r); font-weight: 600; letter-spacing: -0.01em; transition: transform .18s var(--ease), box-shadow .22s, background .2s, border-color .2s, color .2s; }
.btn-primary { box-shadow: 0 6px 18px rgba(46,107,255,.28); }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(46,107,255,.36); }
.btn-dark { box-shadow: 0 6px 18px rgba(10,17,40,.22); }
.btn-dark:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(10,17,40,.3); }
.btn-ghost { border-width: 1.5px; }
.btn-ghost:hover { transform: translateY(-2px); background: var(--surface); border-color: var(--ink); box-shadow: var(--shadow-sm); }
.btn-xl { padding: 18px 30px; font-size: 16px; border-radius: 14px; }

.article-body .btn, .btn { text-decoration: none !important; position: relative; overflow: hidden; font-family: var(--f-display); font-weight: 700; }
.btn > span, .btn svg { position: relative; z-index: 1; }
.btn svg { transition: transform .2s var(--ease); }
.btn:hover svg { transform: translateX(3px); }

.btn-primary::after, .btn-dark::after, .btn-telegram::after { content: ""; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 35%, rgba(255,255,255,.28) 50%, transparent 65%); transform: translateX(-130%); transition: transform .6s var(--ease); pointer-events: none; }
.btn-primary:hover::after, .btn-dark:hover::after, .btn-telegram:hover::after { transform: translateX(130%); }

.btn-primary { background: linear-gradient(135deg, #3B82FF, var(--accent-deep)); color: #fff; box-shadow: 0 8px 22px rgba(38,104,255,.34), inset 0 1px 0 rgba(255,255,255,.22); }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(38,104,255,.44), inset 0 1px 0 rgba(255,255,255,.3); }
.btn-dark { background: linear-gradient(135deg, #1a2445, var(--ink)); color: #fff; box-shadow: 0 8px 22px rgba(10,17,40,.28), inset 0 1px 0 rgba(255,255,255,.12); }
.btn-dark:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(10,17,40,.4), inset 0 1px 0 rgba(255,255,255,.16); }
.btn-telegram { background: linear-gradient(135deg, #2BB0EC, #1a89bd); color: #fff; box-shadow: 0 8px 22px rgba(34,158,217,.36), inset 0 1px 0 rgba(255,255,255,.22); }
.btn-telegram:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(34,158,217,.46), inset 0 1px 0 rgba(255,255,255,.3); }
.btn-ghost { background: transparent; border: 1.5px solid var(--border-2); color: var(--ink); }
.btn-ghost:hover { transform: translateY(-2px); border-color: var(--ink); background: var(--surface); box-shadow: 0 8px 20px rgba(10,17,40,.1); }

#cta .btn-primary, #cta .btn-dark { background: linear-gradient(135deg, #3B82FF, var(--accent-deep)); color: #fff; box-shadow: 0 8px 22px rgba(38,104,255,.4), inset 0 1px 0 rgba(255,255,255,.24); }
#cta .btn-primary:hover, #cta .btn-dark:hover { box-shadow: 0 14px 34px rgba(38,104,255,.5), inset 0 1px 0 rgba(255,255,255,.3); }
#cta .btn-ghost { border-color: rgba(255,255,255,.3); color: #fff; }
#cta .btn-ghost:hover { background: rgba(255,255,255,.1); border-color: #fff; box-shadow: none; }

.room-facts-cta, .side-cta-btn { position: relative; overflow: hidden; }
.room-facts-cta::after, .side-cta-btn::after { content: ""; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 35%, rgba(255,255,255,.28) 50%, transparent 65%); transform: translateX(-130%); transition: transform .6s var(--ease); pointer-events: none; }
.room-facts-cta:hover::after, .side-cta-btn:hover::after { transform: translateX(130%); }
.room-facts-cta > *, .side-cta-btn > * { position: relative; z-index: 1; }

.breadcrumbs { font-size: 13px; padding: 22px 0 4px; }
.breadcrumbs a { color: var(--ink-3); transition: color .15s; }
.breadcrumbs a:hover { color: var(--accent); }
.breadcrumbs .current { color: var(--ink-2); font-weight: 500; }

.room-hero { padding: 44px 0 72px; }
.room-hero-inner { gap: 64px; align-items: start; }

.room-tag { padding: 8px 14px; border-radius: 100px; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow-sm); font-size: 12px; font-weight: 500; color: var(--ink-2); margin-bottom: 26px; }

.room-hero h1 { font-size: clamp(44px, 5.4vw, 76px); line-height: .98; letter-spacing: -0.04em; margin-bottom: 22px; }
.room-hero h1 em { color: var(--accent); }
.room-hero-lead { font-size: 18.5px; line-height: 1.6; color: var(--ink-2); max-width: 560px; }

.room-verdict { margin-top: 34px; padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); gap: 26px; }
.room-score { padding-right: 26px; }
.room-score-num { font-family: var(--f-display); font-weight: 700; font-size: 52px; letter-spacing: -0.04em; color: var(--ink); line-height: .9; }
.room-score-of { font-family: var(--f-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
.room-verdict-label { font-family: var(--f-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
.room-verdict-text p { font-size: 15px; line-height: 1.55; color: var(--ink-2); }

.room-hero-ctas { margin-top: 30px; gap: 12px; }

.room-facts { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); box-shadow: var(--shadow-md); padding: 28px; }
.room-facts-badge { gap: 14px; margin-bottom: 22px; padding-bottom: 22px; border-bottom: 1px solid var(--border); }
.room-facts-logo { width: 52px; height: 52px; border-radius: 13px; font-family: var(--f-display); font-weight: 700; font-size: 18px; color: #fff; background: linear-gradient(135deg, #2668FF, #1E52D9); box-shadow: var(--shadow-sm); display: flex; align-items: center; justify-content: center; }
.room-facts-name { font-family: var(--f-display); font-weight: 700; font-size: 19px; letter-spacing: -0.02em; }
.room-facts-sub { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); margin-top: 3px; }
.room-facts .fact { padding: 13px 0; }
.room-facts dt { font-size: 13.5px; color: var(--ink-2); }
.room-facts dd { font-size: 14.5px; font-weight: 600; color: var(--ink); }
.room-facts dd.pending { font-weight: 500; color: var(--ink-3); font-style: normal; }
.room-facts dd.highlight { color: var(--gold); font-family: var(--f-display); font-weight: 700; }
.room-facts-cta { margin-top: 22px; padding: 15px; border-radius: var(--r); background: var(--ink); color: #fff; font-weight: 600; font-size: 14.5px; box-shadow: 0 6px 18px rgba(10,17,40,.22); transition: transform .18s var(--ease), background .2s, box-shadow .22s; }
.room-facts-cta:hover { background: var(--accent); transform: translateY(-2px); box-shadow: 0 12px 28px rgba(46,107,255,.34); }
.room-facts-note { font-size: 12px; color: var(--ink-3); margin-top: 12px; line-height: 1.5; }

.article { padding-top: 8px; }
.article-toc { position: sticky; top: 96px; }
.article-toc-label { font-family: var(--f-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 14px; }
.article-toc a { display: block; padding: 7px 0 7px 14px; font-size: 13.5px; color: var(--ink-3); border-left: 2px solid var(--border); transition: color .15s, border-color .15s; }
.article-toc a:hover { color: var(--ink); }
.article-toc a.active { color: var(--accent); border-left-color: var(--accent); font-weight: 500; }

.article-body section { scroll-margin-top: 96px; margin-bottom: 56px; }
.article-body h2 { font-family: var(--f-display); font-weight: 700; font-size: clamp(28px, 3vw, 38px); letter-spacing: -0.03em; margin-bottom: 22px; }
.article-body h2 em { color: var(--accent); font-style: normal; }
.article-body p { font-size: 16.5px; line-height: 1.72; color: var(--ink-2); margin-bottom: 18px; }
.article-body p strong { color: var(--ink); font-weight: 600; }
.article-body em { font-style: italic; }

.info-card { background: var(--surface-warm); border: 1px solid rgba(224,169,59,.28); border-radius: var(--r-lg); padding: 22px 24px; margin: 24px 0; }
.info-card p { margin: 0; color: var(--ink-2); font-size: 15.5px; }
.info-card p strong { color: var(--gold-deep); }

.article-body table { border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); border: 1px solid var(--border); }
.article-body th { background: var(--surface-alt); font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
.article-body td, .article-body th { padding: 13px 16px; }

.proscons { gap: 20px; }
.proscons-block { border-radius: var(--r-lg); padding: 26px; border: 1px solid var(--border); background: var(--surface); box-shadow: var(--shadow-sm); }
.proscons-pros { border-top: 3px solid var(--success); }
.proscons-cons { border-top: 3px solid var(--hot); }
.proscons-title { font-family: var(--f-display); font-weight: 700; font-size: 17px; letter-spacing: -0.02em; margin-bottom: 16px; }
.proscons-pros .proscons-title { color: var(--success); }
.proscons-cons .proscons-title { color: var(--hot); }
.proscons-block li { font-size: 15px; line-height: 1.55; color: var(--ink-2); padding: 8px 0; }
.proscons-block li strong { color: var(--ink); font-weight: 600; }

.side-cta { background: var(--surface-dark); color: #fff; border-radius: var(--r-lg); padding: 26px; box-shadow: var(--shadow-md); }
.side-cta-label { font-family: var(--f-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.55); margin-bottom: 10px; }
.side-cta-value { font-family: var(--f-display); font-weight: 700; font-size: 44px; letter-spacing: -0.04em; color: var(--gold); line-height: .95; }
.side-cta-value em { font-family: var(--f-serif); font-style: italic; font-weight: 400; font-size: 30px; }
.side-cta-desc { font-size: 13px; line-height: 1.5; color: rgba(255,255,255,.62); margin: 14px 0 18px; }
.side-cta-btn { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-radius: var(--r); background: var(--accent); color: #fff; font-weight: 600; font-size: 14.5px; transition: transform .18s var(--ease), background .2s; }
.side-cta-btn:hover { background: var(--accent-deep); transform: translateY(-2px); }
.side-cta-btn svg { width: 16px; height: 16px; }

.side-related { margin-top: 24px; padding: 22px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); }
.side-related-title { font-family: var(--f-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 14px; }
.side-related li { padding: 8px 0; border-bottom: 1px solid var(--border); }
.side-related li:last-child { border-bottom: none; }
.side-related a { font-size: 14px; color: var(--ink-2); transition: color .15s; }
.side-related a:hover { color: var(--accent); }

#cta { background: var(--surface-dark); color: #fff; border-radius: var(--r-xl); padding: 56px 48px; text-align: center; }
#cta h2 { color: #fff; }
#cta h2 em { color: var(--gold); font-style: normal; }
#cta p { color: rgba(255,255,255,.7); max-width: 560px; margin: 0 auto; }
#cta .btn-dark, #cta .btn-primary { background: var(--accent); color: #fff; box-shadow: 0 6px 18px rgba(46,107,255,.34); }
#cta .btn-dark:hover, #cta .btn-primary:hover { background: var(--accent-deep); }
#cta .btn-ghost { border-color: rgba(255,255,255,.28); color: #fff; }
#cta .btn-ghost:hover { background: rgba(255,255,255,.1); border-color: #fff; }
#cta > div { justify-content: center; }

.footer { background: var(--surface-dark); }

[data-reveal] { opacity: 0; transform: translateY(20px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
[data-reveal].is-in { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1 !important; transform: none !important; } }

.nav-burger { display: none; width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--border); color: var(--ink); align-items: center; justify-content: center; transition: all .15s; }
.nav-burger:hover { border-color: var(--ink-2); }
.nav-burger svg { width: 18px; height: 18px; }
.nav-burger .icon-x { display: none; }
.nav-burger[aria-expanded="true"] .icon-x { display: block; }
.nav-burger[aria-expanded="true"] .icon-bars { display: none; }
.nav-drawer { display: none; border-top: 1px solid var(--border); background: var(--surface); padding: 12px 20px 20px; }
.nav-drawer.is-open { display: block; }
.nav-drawer a { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid var(--border); font-size: 16px; font-weight: 500; color: var(--ink); }
.nav-drawer a:last-of-type { border-bottom: none; }
.nav-drawer .btn { width: 100%; justify-content: center; margin-top: 14px; }

a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

@media (max-width: 720px) {
  body { font-size: 16px; }
  .nav-burger { display: inline-flex; }
  .nav-actions .btn-primary { display: none; }
  .room-hero { padding: 24px 0 48px; }
  .room-hero h1 { font-size: clamp(36px, 10vw, 52px); }
  .article-toc { display: none; }
}

.lang { display: inline-flex; align-items: center; gap: 0; padding: 2px; background: var(--surface-2, rgba(128,128,128,0.08)); border: 1px solid var(--line); border-radius: 999px; font-family: var(--f-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.06em; }
.lang a { display: inline-flex; align-items: center; justify-content: center; min-width: 34px; padding: 5px 10px; border-radius: 999px; color: var(--ink-3); text-decoration: none; transition: color 0.15s, background 0.15s; }
.lang a:hover { color: var(--ink); }
.lang a[aria-current="page"] { color: var(--ink); background: var(--bg, #fff); box-shadow: 0 1px 2px rgba(0,0,0,0.08); }

.room-facts-cta { background: linear-gradient(135deg, #1a2445, var(--ink)) !important; color: #fff; box-shadow: 0 8px 22px rgba(10,17,40,.28), inset 0 1px 0 rgba(255,255,255,.12); }
.room-facts-cta:hover { background: linear-gradient(135deg, #22305c, #0d1530) !important; transform: translateY(-2px); box-shadow: 0 14px 32px rgba(10,17,40,.4), inset 0 1px 0 rgba(255,255,255,.16); }
