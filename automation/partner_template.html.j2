<script>
const tocLinks = document.querySelectorAll('.toc-link, .article-toc a');
const sections = document.querySelectorAll('.article-body section[id]');

function updateActiveToc() {
  const scrollPos = window.scrollY + 140;
  let currentSection = sections[0]?.id;
  sections.forEach(section => {
    if (section.offsetTop <= scrollPos) { currentSection = section.id; }
  });
  tocLinks.forEach(link => {
    link.classList.toggle('active', link.getAttribute('href') === '#' + currentSection);
  });
}

window.addEventListener('scroll', updateActiveToc, { passive: true });
updateActiveToc();

document.querySelectorAll('.article-faq-item').forEach(item => {
  item.querySelector('.article-faq-q').addEventListener('click', () => {
    item.classList.toggle('open');
  });
});
</script>

<script>
(function () {
  'use strict';
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var nav = document.querySelector('.nav');
  if (nav) {
    var onScroll = function () { nav.classList.toggle('is-stuck', window.scrollY > 8); };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  var nodes = [].slice.call(document.querySelectorAll('.article-body section, .room-verdict, .room-facts'));
  nodes.forEach(function (el) { el.setAttribute('data-reveal', ''); });
  if (reduce || !('IntersectionObserver' in window)) {
    nodes.forEach(function (el) { el.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
    nodes.forEach(function (el) { io.observe(el); });
  }

  var links = [].slice.call(document.querySelectorAll('.article-toc a'));
  var secs = links.map(function (a) {
    var id = a.getAttribute('href');
    return id && id.charAt(0) === '#' ? document.querySelector(id) : null;
  });
  if (links.length && 'IntersectionObserver' in window) {
    var spy = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var i = secs.indexOf(e.target);
        if (i === -1) return;
        links.forEach(function (l) { l.classList.remove('active'); });
        links[i].classList.add('active');
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    secs.forEach(function (s) { if (s) spy.observe(s); });
  }

  var b = document.getElementById('nav-burger');
  var d = document.getElementById('nav-drawer');
  if (b && d) {
    b.addEventListener('click', function () {
      var open = d.classList.toggle('is-open');
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    d.addEventListener('click', function (e) {
      if (e.target.closest('a')) { d.classList.remove('is-open'); b.setAttribute('aria-expanded', 'false'); }
    });
  }
})();
</script>
<script>
(function () {
  'use strict';
  var pageParams = new URLSearchParams(window.location.search);
  var PASS = ['gclid', 'fbclid', 'ttclid', 'msclkid',
              'utm_source', 'utm_medium', 'utm_campaign', 'utm_term',
              'utm_content', 'utm_creative', 'utm_network', 'utm_placement',
              'utm_match', 'utm_position', 'utm_target', 'keyword'];

  function pageSlug() {
    var p = window.location.pathname.replace(/\/index\.html$/, '/').replace(/\/$/, '');
    var parts = p.split('/').filter(Boolean);
    return parts.length ? parts[parts.length - 1] : 'home';
  }

  function buildUrl(base, btnLabel) {
    var u;
    try { u = new URL(base, window.location.origin); }
    catch (e) { return base; }
    var q = u.searchParams;
    PASS.forEach(function (k) {
      var v = pageParams.get(k);
      if (v && v.indexOf('{') === -1) q.set(k, v);
    });
    if (!q.has('utm_source'))   q.set('utm_source', 'kozyr');
    if (!q.has('utm_medium'))   q.set('utm_medium', 'referral');
    if (!q.has('utm_campaign')) q.set('utm_campaign', pageSlug());
    if (btnLabel) q.set('utm_content', btnLabel);
    return u.toString();
  }

  function slugify(s) {
    return (s || '').trim().toLowerCase()
      .replace(/[^\wа-яё]+/gi, '-').replace(/^-+|-+$/g, '').slice(0, 40) || 'cta';
  }

  document.querySelectorAll('a[data-partner]').forEach(function (a) {
    var base = a.getAttribute('href');
    var label = slugify(a.textContent);
    a.setAttribute('href', buildUrl(base, label));
    a.setAttribute('rel', 'nofollow sponsored noopener');
    a.setAttribute('target', '_blank');
  });
})();
</script>
