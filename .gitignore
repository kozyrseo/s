# ============================================================================
# KOZYR — .gitignore  (исправлено 2026-08-17)
# ВАЖНО: automation/, *.py и requirements.txt НЕ игнорируются — их запускают
# GitHub Actions (generate/publish/translate). Их игнор сломает генерацию статей.
# ============================================================================

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Секреты
.env
.env.local
.env.*.local

# Runtime-состояние бота и сгенерированные отчёты — НЕ коммитить
.bot_state/
analytics/

# Транзиентные заметки сессий (README.md и DEPLOY.md остаются в репозитории)
CHANGES.md
STATUS.md
BLOG-*.md
FAVICON-*.md
FIXES-*.md
DEPLOY-V3.md
DEPLOY-FINAL.md

# Редактор / ОС
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Node
node_modules/
package-lock.json
